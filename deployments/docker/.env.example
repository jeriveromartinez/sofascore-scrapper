# Copy to .env and REPLACE every placeholder below before starting the stack.
#
#   cp deployments/docker/.env.example deployments/docker/.env
#
# The placeholders are intentionally invalid: the app refuses to start with
# a JWT_SECRET shorter than 32 characters (see internal/config/config.go).

# Database password for the local MariaDB instance. Replace with your own.
DB_PASSWORD=change-me

# JWT signing secret. Must be at least 32 characters. Replace with a random
# value, e.g. `openssl rand -base64 48`.
JWT_SECRET=CHANGE_ME_32_CHARS_MINIMUM

DB_NAME=scores365
API_PORT=8080

# 365scores source (all optional; defaults shown).
# SCORES365_LANG_ID=29
# SCORES365_TIMEZONE=UTC
# SCORES365_COUNTRY_ID=116
# SCORES365_DISCOVERY_SPORTS=basketball,tennis,ice-hockey,handball,american-football,baseball,volleyball,rugby

# Required: MariaDB root password. Must match between the mariadb service
# and the backend service. The mariadb service uses it as
# MARIADB_ROOT_PASSWORD; the backend uses it as DB_PASSWORD for the root
# account (the compose file hardcodes DB_USER=root on the backend side).
#
# Generate a strong one for local dev, e.g.:
#   openssl rand -base64 24
DB_PASSWORD=change-me

# Required: HMAC secret for JWT access + refresh tokens. Must be at least
# 32 bytes of random data; the backend refuses to start without it.
#
# Generate one with:
#   openssl rand -base64 48
JWT_SECRET=change-me-at-least-32-bytes-of-base64

# Optional: database name created at first MariaDB boot. Defaults to
# "sofascore" if unset.
# DB_NAME=sofascore

# Optional: host port that maps to the backend container port 8080.
# Defaults to 8080 if unset.
# API_PORT=8080

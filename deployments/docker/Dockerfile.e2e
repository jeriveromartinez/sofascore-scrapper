# Test image: the backend plus the web dashboard, built by
# deployments/docker/compose.test.yml.
#
# It differs from the production image in two ways:
#   - it starts through entrypoint.test.sh, which honours BOOTSTRAP_ONLY
#     so the one-shot service can seed an invitation token;
#   - it runs as root, because that one-shot service has to write the
#     token into the shared volume.
#
# Build:
#   docker build -f deployments/docker/Dockerfile.e2e -t scores365-e2e .

FROM node:22-alpine AS build-vue

WORKDIR /app/web

COPY web/package.json web/package-lock.json ./
RUN npm ci

COPY web/ ./
RUN npm run build

FROM golang:1.25-alpine AS build-go

WORKDIR /app

COPY go.mod go.sum ./
RUN go mod download

COPY . .
ARG VERSION="v0.0.0-dev"
ARG COMMIT="unknown"
RUN CGO_ENABLED=0 go build \
    -ldflags="-s -w -X github.com/jeriveromartinez/scores365-scrapper/internal/buildinfo.Version=${VERSION} -X github.com/jeriveromartinez/scores365-scrapper/internal/buildinfo.Commit=${COMMIT}" \
    -o /out/scores365-scrapper ./cmd/server

FROM alpine:3.20

RUN apk add --no-cache ca-certificates su-exec wget tzdata

WORKDIR /app

COPY --from=build-go /out/scores365-scrapper .
COPY --from=build-vue /app/web/dist ./web/dist
COPY deployments/docker/entrypoint.test.sh /usr/local/bin/entrypoint.sh

RUN chmod +x /usr/local/bin/entrypoint.sh

HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=3 \
    CMD wget -qO- http://localhost:8080/health/live || exit 1

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["./scores365-scrapper"]

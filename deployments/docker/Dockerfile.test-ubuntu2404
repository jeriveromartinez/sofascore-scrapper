# Test image: Ubuntu 24.04 + MariaDB + Redis, runs the .deb chain
# (.deb files are mounted at runtime into /tmp/dist/).
#
# Build:
#   docker build -f deployments/docker/Dockerfile.test-ubuntu2404 -t iptv-chain-test .
# Run:
#   docker run --rm -p 8080:8080 \
#       -v "$PWD/dist:/tmp/dist:ro" \
#       iptv-chain-test

FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        mariadb-server \
        redis-server \
        sudo \
        wget \
    && rm -rf /var/lib/apt/lists/*

# The chain driver.
COPY deployments/docker/test-migration-chain.sh /usr/local/bin/test-migration-chain.sh
RUN chmod +x /usr/local/bin/test-migration-chain.sh

EXPOSE 8080

HEALTHCHECK --interval=5s --timeout=3s --start-period=10s --retries=10 \
    CMD wget -qO- http://localhost:8080/health/live || exit 1

ENTRYPOINT ["/usr/local/bin/test-migration-chain.sh"]

GO_MODULE := github.com/jeriveromartinez/scores365-scrapper
PROTO_FILE := proto/api.proto
GENERATED_DIR := internal/gen
WEB_PROTO_DIR := web/src/proto
FLUTTER_PROTO_URL := https://raw.githubusercontent.com/jeriveromartinez/flutter-apptv/main/proto/api.proto

# The dashboard bindings are generated by the ts-proto plugin, which the
# web workspace installs. It is a shell script on Unix and a .cmd wrapper
# on Windows, and protoc only runs a plugin it can address by an
# absolute path.
ifeq ($(OS),Windows_NT)
TS_PROTO_PLUGIN := $(CURDIR)/web/node_modules/.bin/protoc-gen-ts_proto.cmd
else
TS_PROTO_PLUGIN := $(CURDIR)/web/node_modules/.bin/protoc-gen-ts_proto
endif

.PHONY: proto proto-check proto-web proto-web-check proto-verify-flutter help

help:
	@echo "Available targets:"
	@echo "  make proto                  Regenerate Go bindings from $(PROTO_FILE)"
	@echo "  make proto-check           Regenerate and fail if internal/gen/ has uncommitted changes"
	@echo "  make proto-web             Regenerate the dashboard bindings from $(PROTO_FILE)"
	@echo "  make proto-web-check       Regenerate and fail if $(WEB_PROTO_DIR)/ has uncommitted changes"
	@echo "  make proto-verify-flutter   Fail if flutter-apptv's proto/api.proto drifts from this one"

# Regenerate Go bindings from proto/api.proto.
# Output lands in $(GENERATED_DIR) because that matches the `option go_package`
# in $(PROTO_FILE).
# The committed bindings were produced with protoc 28.3 and protoc-gen-go
# v1.36.8, the version go.mod pins.
proto:
	protoc \
		--go_out=. \
		--go_opt=module=$(GO_MODULE) \
		$(PROTO_FILE)

# Regenerate and fail if the working tree has uncommitted changes inside
# $(GENERATED_DIR). Used by the CI `proto-diff` job to catch stale bindings.
proto-check: proto
	@if ! git diff --exit-code $(GENERATED_DIR) > /dev/null 2>&1; then \
		echo "Generated protobuf code is out of date. Run 'make proto' and commit."; \
		git diff $(GENERATED_DIR); \
		exit 1; \
	fi
	@echo "Generated protobuf code is up to date."

# Regenerate the TypeScript bindings of the dashboard from proto/api.proto.
# The committed bindings were produced with protoc 24.3 and ts-proto
# v2.11.5, the version web/package.json pins.
proto-web:
	@test -f $(TS_PROTO_PLUGIN) || { echo "The ts-proto plugin is missing. Run 'npm ci' in web/ first."; exit 1; }
	protoc \
		--plugin=protoc-gen-ts_proto=$(TS_PROTO_PLUGIN) \
		--ts_proto_out=$(WEB_PROTO_DIR) \
		--ts_proto_opt=useOptionals=messages \
		-I proto api.proto

# Regenerate the dashboard bindings and fail if they differ from the
# committed ones. The version of protoc is recorded in the header of the
# generated file and changes nothing else, so that line is ignored: a
# newer protoc does not make the bindings stale.
proto-web-check: proto-web
	@if ! git diff --exit-code --ignore-matching-lines='protoc +v[0-9]' $(WEB_PROTO_DIR)/api.ts > /dev/null 2>&1; then \
		echo "The generated web bindings are out of date. Run 'make proto-web' and commit."; \
		git diff $(WEB_PROTO_DIR); \
		exit 1; \
	fi
	@echo "The generated web bindings are up to date."

# Verify the Flutter client's proto/api.proto is a verbatim copy of this repo's.
# The contract is documented in docs/integration-audit-roadmap.md: the Go repo
# is the source of truth and flutter-apptv must mirror proto/api.proto.
proto-verify-flutter:
	@curl -fsSL $(FLUTTER_PROTO_URL) -o /tmp/flutter-api.proto
	@if ! diff -q $(PROTO_FILE) /tmp/flutter-api.proto > /dev/null 2>&1; then \
		echo "Flutter proto is out of sync with the Go source of truth."; \
		echo "Run 'cp $(PROTO_FILE) ../flutter-apptv/proto/api.proto' and regenerate the Dart bindings."; \
		diff $(PROTO_FILE) /tmp/flutter-api.proto | head -80; \
		exit 1; \
	fi
	@echo "Flutter proto is in sync."
